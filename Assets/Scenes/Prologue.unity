--- !u!114 &468843600
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 468843599}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 202e85b1ba6454029bec8ee528fa9645, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 1436975624}
  defaultFontSize: 42
  lines:
  - text: "\u4F60\u77E5\u9053\u6F5C\u610F\u8BC6\u5417\uFF1F"
    fadeIn: 1.5
    hold: 2.5
    fadeOut: 1.2
    fontSizeOverride: 52
  - text: "\u6211\u4EEC\u6E05\u9192\u65F6\u770B\u4E0D\u89C1\u5B83\u3002\n\u4F46\u5B83\u4E00\u76F4\u5728\u90A3\u91CC\u2014\u2014\n\u5728\u6BCF\u4E00\u6B21\u5FC3\u8DF3\u3001\u6BCF\u4E00\u4E2A\u68A6\u3001\n\u6BCF\u4E00\u6B21\u5931\u8BED\u4E4B\u95F4\u3002"
    fadeIn: 1.5
    hold: 5
    fadeOut: 1.5
    fontSizeOverride: 40
  - text: "\u300C\u672A\u88AB\u8868\u8FBE\u7684\u60C5\u7EEA\u6C38\u8FDC\u4E0D\u4F1A\u6D88\u5931\u3002\n\u5B83\u4EEC\u53EA\u662F\u88AB\u6D3B\u57CB\u4E86\uFF0C\n\u6709\u4E00\u5929\u4F1A\u4EE5\u66F4\u4E11\u964B\u7684\u65B9\u5F0F\u6D8C\u51FA\u3002\u300D\n\n\u2014\u2014
      \u897F\u683C\u8499\u5FB7\xB7\u5F17\u6D1B\u4F0A\u5FB7"
    fadeIn: 1.5
    hold: 6
    fadeOut: 1.5
    fontSizeOverride: 38
  - text: "\u300C\u76F4\u5230\u4F60\u8BA9\u6F5C\u610F\u8BC6\u6D6E\u4E0A\u610F\u8BC6\uFF0C\n\u5B83\u90FD\u5C06\u4E3B\u5BB0\u4F60\u7684\u4EBA\u751F\u2014\u2014\n\u800C\u4F60\u5C06\u79F0\u4E4B\u4E3A\"\u547D\u8FD0\"\u3002\u300D\n\n\u2014\u2014
      \u5361\u5C14\xB7\u8363\u683C"
    fadeIn: 1.5
    hold: 6
    fadeOut: 1.5
    fontSizeOverride: 38
  - text: "\u300C\u4EBA\u6700\u5927\u7684\u654C\u4EBA\uFF0C\n\u662F\u81EA\u5DF1\u5185\u5FC3\u7684\u9634\u5F71\u3002\u300D\n\n\u2014\u2014
      \u963F\u5C14\u5F17\u96F7\u5FB7\xB7\u963F\u5FB7\u52D2"
    fadeIn: 1.5
    hold: 5
    fadeOut: 1.5
    fontSizeOverride: 38
  - text: "\u4ECA\u5929\uFF0C\u6211\u53C8\u4E00\u6B21\u8D70\u5230\u4E86\u90A3\u6247\u9762\u524D\u2014\u2014\n\n\u4E5F\u8BB8\u662F\u8BCA\u5BA4\u3002\n\u4E5F\u8BB8\u662F\u6211\u5FC3\u91CC\u90A3\u6247\u7D27\u95ED\u7684\u623F\u95F4\u3002"
    fadeIn: 1.5
    hold: 6
    fadeOut: 2
    fontSizeOverride: 42
  bgmCue: {fileID: 11400000, guid: 6d542d55c00e34d78a8c32709c71b55f, type: 2}
  nextSceneName: Reality_Room
  useFadeTransition: 1
  allowSkip: 1
  skipKey: 32
  skipOnMouseClick: 1
  initialDelay: 1.5
