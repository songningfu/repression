    portraitKey: Portrait_LinGuNian
    text: "\u2026\u2026\u8FD8\u662F\u7B97\u4E86\u3002"
    nextId: 
  - nodeId: 11500
    speakerName: "\u65C1\u767D"
    portraitKey: 
    text: "\u7FFB\u76D6\u624B\u673A\u5C4F\u5E55\u4EAE\u8D77\uFF0C\u4E00\u6761\u672A\u8BFB\u77ED\u4FE1\u3002\u53D1\u4EF6\u4EBA\uFF1A\u8001\u5F20\u2014\u2014\u201C\u6628\u5929\u770B\u4F60\u56DE\u6765\u8138\u8272\u5F88\u5DEE\uFF0C\u8FD9\u4E24\u5929\u522B\u592A\u7D2F\u4E86\u3002\u51B0\u7BB1\u91CC\u8FD8\u6709\u997A\u5B50\uFF0C\u8BB0\u5F97\u5403\u3002\u201D"
