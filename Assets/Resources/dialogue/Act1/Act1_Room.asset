  - nodeId: 11410
    speakerName: "\u6797\u987E\u5FF5"
    portraitKey: Portrait_LinGuNian
    text: "\u4ED6\u76EF\u7740\u90A3\u76D2\u70DF\u3002"
    nextId: 
  - nodeId: 11420
    speakerName: "\u6797\u987E\u5FF5"
    portraitKey: Portrait_LinGuNian
    text: "\uFF08\u6DF1\u5438\u4E00\u53E3\uFF0C\u7F13\u7F13\u5410\u51FA\u3002\uFF09\u2026\u2026\u597D\u4E00\u70B9\u4E86\u3002\u5C31\u4E00\u70B9\u3002\uFF08\u5E94\u6FC0\u5EA6
