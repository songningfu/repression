  - nodeId: 13200
    speakerName: "\u65C1\u767D"
    portraitKey: 
    text: "\u9508\u8FF9\u6591\u6591\u7684\u544A\u793A\u680F\u8D34\u6EE1\u5C0F\u5E7F\u544A\uFF0C\u4E2D\u95F4\u4E00\u5F20\u7269\u4E1A\u901A\u77E5\uFF1A\u201C\u5173\u4E8E\u672C\u5C0F\u533A\u8001\u65E7\u4F9B\u6C34\u8BBE\u65BD\u66F4\u6362\u5DE5\u4F5C\u7684\u901A\u77E5\u2026\u2026\u5DF2\u4E8E2014\u5E744\u6708\u5B8C\u6210\u2026\u2026\u201D\u540E\u9762\u88AB\u4E00\u5F20\u62DB\u8058\u542F\u4E8B\u76D6\u4F4F\u3002"
    nextId: 13210
  - nodeId: 13210
    speakerName: "\u6797\u987E\u5FF5"
    portraitKey: Portrait_LinGuNian
    text: "\u2026\u2026\uFF08\u4ED6\u7684\u76EE\u5149\u5728\u201C\u4F9B\u6C34\u8BBE\u65BD\u66F4\u6362\u201D\u51E0\u4E2A\u5B57\u4E0A\u505C\u4E86\u4E0D\u5230\u4E00\u79D2\uFF0C\u7136\u540E\u79FB\u5F00\u4E86\u3002\uFF09"
    nextId: 
  - nodeId: 13300
    speakerName: "\u65C1\u767D"
    portraitKey: 
    text: "\u8D70\u5230\u62D0\u89D2\u65F6\uFF0C\u8FDC\u5904\u7A81\u7136\u4F20\u6765\u4E00\u9635\u72D7\u53EB\uFF0C\u5C16\u9510\u800C\u6025\u4FC3\u3002"
