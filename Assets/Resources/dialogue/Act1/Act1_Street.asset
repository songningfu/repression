    text: "\uFF08\u642C\u8D27\u4EFB\u52A1\uFF1A\u628A\u8D27\u7BB1\u4ECE\u4ED3\u5E93\u642C\u5230\u8D27\u67B6\u6307\u5B9A\u4F4D\u7F6E\u3002\u80CC\u666F\u91CC\u6536\u97F3\u673A\u64AD\u7740\u65E0\u5173\u7D27\u8981\u7684\u672C\u5730\u65B0\u95FB\u2014\u2014\u5929\u6C14\u3001\u8001\u57CE\u533A\u4FEE\u7F2E\u3002\uFF09"
