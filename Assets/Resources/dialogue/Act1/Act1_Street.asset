    portraitKey: Portrait_StoreOwner
    text: "\u6765\u4E86\uFF1F\u4ECA\u5929\u8D27\u591A\uFF0C\u540E\u9762\u4ED3\u5E93\u5806\u4E86\u5341\u51E0\u7BB1\uFF0C\u4F60\u6162\u6162\u642C\uFF0C\u522B\u7740\u6025\u3002"
