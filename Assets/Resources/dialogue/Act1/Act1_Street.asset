  - nodeId: 13100
    speakerName: "\u65C1\u767D"
    portraitKey: 
    text: "\u4E00\u5BB6\u62C9\u4E0B\u5377\u5E18\u95E8\u7684\u5C0F\u5546\u94FA\uFF0C\u95E8\u4E0A\u8D34\u7740\u76B1\u5DF4\u5DF4\u7684\u544A\u793A\uFF1A\u201C\u65FA\u94FA\u8F6C\u8BA9\uFF0C\u8054\u7CFB\u7535\u8BDD\uFF1A138\u2026\u2026\u201D\u7EB8\u5DF2\u6CDB\u9EC4\uFF0C\u7535\u8BDD\u88AB\u96E8\u6C34\u6D07\u5F97\u6A21\u7CCA\u3002"
